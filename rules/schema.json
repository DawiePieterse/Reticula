{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reticula.app/rules/schema.json",
  "title": "Reticula authority rules file",
  "type": "object",
  "required": [
    "authority",
    "version",
    "effective_date",
    "standards",
    "voltage",
    "conductors"
  ],
  "additionalProperties": false,
  "properties": {
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "base": {
      "type": "string",
      "description": "Rules file this one overrides, as authority/version"
    },
    "notes": {
      "type": "string"
    },
    "standards": {
      "type": "object",
      "description": "Standard id -> edition used by this rules file",
      "additionalProperties": {
        "type": "string"
      }
    },
    "voltage": {
      "type": "object",
      "required": [
        "lv_nominal_v",
        "lv_max_drop_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "lv_nominal_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lv_max_drop_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mv_nominal_kv": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "clause": {
          "type": "string"
        },
        "index": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Id of the clause in docs/standards-index.md"
        }
      }
    },
    "conductors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "kind",
          "r_ohm_per_km",
          "x_ohm_per_km",
          "rating_a"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "overhead",
              "underground"
            ]
          },
          "r_ohm_per_km": {
            "type": "number",
            "minimum": 0
          },
          "x_ohm_per_km": {
            "type": "number",
            "minimum": 0
          },
          "rating_a": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "clause": {
            "type": "string"
          },
          "index": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
            "description": "Id of the clause in docs/standards-index.md"
          },
          "material": {
            "type": "string",
            "enum": [
              "cu",
              "al"
            ]
          },
          "size_mm2": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Nominal phase conductor size"
          },
          "cores": {
            "type": "integer",
            "minimum": 1
          },
          "uses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "feeder",
                "service"
              ]
            },
            "description": "feeder: LV distribution; service: from a pole box or kiosk to a customer"
          },
          "ratings_a": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "ground": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pipe": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "air": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "description": "Continuous current rating by installation, A, at the standard conditions of the rating clause"
          },
          "fault_k": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "K in I = K·A/√t, giving kA with A in mm² and t in s"
          },
          "placeholder": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "r_ohm_per_km",
                "x_ohm_per_km",
                "rating_a",
                "ratings_a",
                "fault_k",
                "r_ac_ohm_per_km"
              ]
            },
            "description": "Fields whose values are placeholders, not yet from the governing standard"
          },
          "rating_clause": {
            "type": "string",
            "description": "Where the ratings and fault constant come from, when that differs from clause"
          },
          "r_ac_ohm_per_km": {
            "type": "number",
            "minimum": 0,
            "description": "AC resistance at r_ac_temp_c, ohm/km"
          },
          "r_ac_temp_c": {
            "type": "number",
            "description": "Conductor temperature for r_ac_ohm_per_km, °C"
          }
        }
      }
    },
    "building_prediction": {
      "type": "object",
      "description": "Heuristics that predict a building's type before the field visit.",
      "additionalProperties": false,
      "required": [
        "osm_tags",
        "footprint_m2"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "osm_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "type",
              "confidence"
            ],
            "properties": {
              "match": {
                "type": "string",
                "pattern": "^[a-z_:]+=([A-Za-z0-9_;:-]+|\\*)$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "house",
                  "shop",
                  "school",
                  "other"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "zoning": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "type",
              "confidence"
            ],
            "properties": {
              "match": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "house",
                  "shop",
                  "school",
                  "other"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "footprint_m2": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "type",
              "confidence"
            ],
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "house",
                  "shop",
                  "school",
                  "other"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "agreement_boost": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "low_confidence_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "index": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Id of the clause in docs/standards-index.md"
        }
      }
    },
    "income_admd": {
      "type": "object",
      "additionalProperties": false,
      "description": "Income and ADMD estimation from what an inspector can see on site.",
      "required": [
        "clause",
        "indicators",
        "income_bands",
        "diversity",
        "special_loads"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "indicators": {
          "type": "object",
          "description": "Single-choice observables: option -> points",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "minProperties": 1
              }
            }
          }
        },
        "multi_indicators": {
          "type": "object",
          "description": "Multi-choice observables: each chosen option adds its points",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "minProperties": 1
              }
            }
          }
        },
        "band_indicators": {
          "type": "object",
          "description": "Numeric observables scored by band (upper bound exclusive)",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bands"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "bands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "points"
                  ],
                  "properties": {
                    "max": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "points": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "income_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "band",
              "max_points"
            ],
            "properties": {
              "band": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "max_points": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "admd_kva": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "class": {
                "type": "string",
                "description": "load class code in the design table"
              }
            },
            "oneOf": [
              {
                "required": [
                  "admd_kva",
                  "category"
                ]
              },
              {
                "required": [
                  "class"
                ]
              }
            ]
          }
        },
        "diversity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "formula",
                "k"
              ],
              "properties": {
                "formula": {
                  "const": "admd_n = admd_inf * (1 + k / n)"
                },
                "k": {
                  "type": "number",
                  "minimum": 0
                },
                "clause": {
                  "type": "string"
                },
                "index": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
                  "description": "Id of the clause in docs/standards-index.md"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "confidence_pct"
              ],
              "properties": {
                "method": {
                  "const": "herman_beta"
                },
                "confidence_pct": {
                  "type": "number",
                  "exclusiveMinimum": 50,
                  "exclusiveMaximum": 100
                },
                "phases": {
                  "enum": [
                    1,
                    3
                  ]
                },
                "clause": {
                  "type": "string"
                },
                "index": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
                  "description": "Id of the clause in docs/standards-index.md"
                }
              }
            }
          ]
        },
        "special_loads": {
          "type": "object",
          "description": "Default kVA per special load, always overridable",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1
        },
        "design_table": {
          "type": "string",
          "description": "load_tables id used for classes and Herman-Beta"
        },
        "index": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Id of the clause in docs/standards-index.md"
        }
      }
    },
    "load_tables": {
      "type": "object",
      "description": "Herman-Beta load parameter tables by id",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "horizon_years",
          "phase_voltage_v",
          "classes"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "horizon_years": {
            "type": "integer",
            "minimum": 1
          },
          "phase_voltage_v": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "confidence_pct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100
          },
          "note": {
            "type": "string"
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "description",
                "alpha",
                "beta",
                "c_amps",
                "admd_kva"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "description": {
                  "type": "string"
                },
                "standard_class": {
                  "type": "string"
                },
                "lsm": {
                  "type": "string"
                },
                "income_min_zar": {
                  "type": "number",
                  "minimum": 0
                },
                "income_max_zar": {
                  "type": "number",
                  "minimum": 0
                },
                "alpha": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "beta": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "c_amps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "admd_kva": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "mean_a": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "sd_a": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "unverified"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "lv_network": {
      "type": "object",
      "description": "How LV routes and sites marked in the field are joined into a network (Phase 2.1). Distances in metres.",
      "additionalProperties": false,
      "required": [
        "join_m",
        "near_miss_m",
        "source_reach_m",
        "pole_reach_m",
        "sources"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "index": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Id of the clause in docs/standards-index.md"
        },
        "join_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "A route end this close to another route is joined to it"
        },
        "near_miss_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "A route end closer than this to another route, but not joined, is flagged"
        },
        "source_reach_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "A source site this close to a route feeds it"
        },
        "pole_reach_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "A pole site this close to a route is placed on it"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "transformer",
              "minisub"
            ]
          },
          "description": "Candidate site kinds that feed the LV network"
        }
      }
    },
    "lv_loads": {
      "type": "object",
      "description": "How loads connect to the LV network and are spread over the phases (Phase 2.2).",
      "additionalProperties": false,
      "required": [
        "max_service_m",
        "attach",
        "single_phase_max_kva"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "index": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Id of the clause in docs/standards-index.md"
        },
        "max_service_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Longest service connection from a building to its pole or route, in metres"
        },
        "attach": {
          "type": "string",
          "enum": [
            "pole_boxes",
            "nearest_point"
          ],
          "description": "pole_boxes: services from LV poles through service distribution boxes; nearest_point: to the nearest point on a route, phased per load"
        },
        "single_phase_max_kva": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Loads above this are supplied three-phase"
        },
        "boxes_per_pole": {
          "type": "integer",
          "minimum": 1,
          "description": "Most service distribution boxes on one pole"
        },
        "box_loads": {
          "type": "integer",
          "minimum": 1,
          "description": "Most loads on one box, all on the box's phase"
        },
        "second_box_other_phase": {
          "type": "boolean",
          "description": "A second box on a pole is on a different phase from the first"
        }
      },
      "if": {
        "properties": {
          "attach": {
            "const": "pole_boxes"
          }
        }
      },
      "then": {
        "required": [
          "boxes_per_pole",
          "box_loads",
          "second_box_other_phase"
        ]
      }
    }
  }
}
