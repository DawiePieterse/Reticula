{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reticula.app/rules/schema.json",
  "title": "Reticula authority rules file",
  "type": "object",
  "required": [
    "authority",
    "version",
    "effective_date",
    "standards",
    "voltage",
    "conductors"
  ],
  "additionalProperties": false,
  "properties": {
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "base": {
      "type": "string",
      "description": "Rules file this one overrides, as authority/version"
    },
    "notes": {
      "type": "string"
    },
    "standards": {
      "type": "object",
      "description": "Standard id -> edition used by this rules file",
      "additionalProperties": {
        "type": "string"
      }
    },
    "voltage": {
      "type": "object",
      "required": [
        "lv_nominal_v",
        "lv_max_drop_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "lv_nominal_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lv_max_drop_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mv_nominal_kv": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "clause": {
          "type": "string"
        }
      }
    },
    "conductors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "kind",
          "r_ohm_per_km",
          "x_ohm_per_km",
          "rating_a"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "overhead",
              "underground"
            ]
          },
          "r_ohm_per_km": {
            "type": "number",
            "minimum": 0
          },
          "x_ohm_per_km": {
            "type": "number",
            "minimum": 0
          },
          "rating_a": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "clause": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "feeder",
              "service",
              "mv"
            ]
          },
          "material": {
            "type": "string",
            "enum": [
              "Al",
              "Cu",
              "AlSt"
            ]
          },
          "area_mm2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "neutral_r_ohm_per_km": {
            "type": "number",
            "minimum": 0
          },
          "neutral_x_ohm_per_km": {
            "type": "number",
            "minimum": 0
          },
          "k": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fuse_a": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mass_kg_per_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "diameter_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uts_kn": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "e_gpa": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "alpha_per_c": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "building_prediction": {
      "type": "object",
      "description": "Heuristics that predict a building's type before the field visit.",
      "additionalProperties": false,
      "required": [
        "osm_tags",
        "footprint_m2"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "osm_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "type",
              "confidence"
            ],
            "properties": {
              "match": {
                "type": "string",
                "pattern": "^[a-z_:]+=([A-Za-z0-9_;:-]+|\\*)$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "house",
                  "shop",
                  "school",
                  "other"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "zoning": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "type",
              "confidence"
            ],
            "properties": {
              "match": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "house",
                  "shop",
                  "school",
                  "other"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "footprint_m2": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "type",
              "confidence"
            ],
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "house",
                  "shop",
                  "school",
                  "other"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "agreement_boost": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "low_confidence_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "income_admd": {
      "type": "object",
      "additionalProperties": false,
      "description": "Income and ADMD estimation from what an inspector can see on site.",
      "required": [
        "clause",
        "indicators",
        "income_bands",
        "diversity",
        "special_loads"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "indicators": {
          "type": "object",
          "description": "Single-choice observables: option -> points",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "minProperties": 1
              }
            }
          }
        },
        "multi_indicators": {
          "type": "object",
          "description": "Multi-choice observables: each chosen option adds its points",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "minProperties": 1
              }
            }
          }
        },
        "band_indicators": {
          "type": "object",
          "description": "Numeric observables scored by band (upper bound exclusive)",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bands"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "bands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "points"
                  ],
                  "properties": {
                    "max": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "points": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "income_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "band",
              "max_points"
            ],
            "properties": {
              "band": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "max_points": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "admd_kva": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "class": {
                "type": "string",
                "description": "load class code in the design table"
              }
            },
            "oneOf": [
              {
                "required": [
                  "admd_kva",
                  "category"
                ]
              },
              {
                "required": [
                  "class"
                ]
              }
            ]
          }
        },
        "diversity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "formula",
                "k"
              ],
              "properties": {
                "formula": {
                  "const": "admd_n = admd_inf * (1 + k / n)"
                },
                "k": {
                  "type": "number",
                  "minimum": 0
                },
                "clause": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "confidence_pct"
              ],
              "properties": {
                "method": {
                  "const": "herman_beta"
                },
                "confidence_pct": {
                  "type": "number",
                  "exclusiveMinimum": 50,
                  "exclusiveMaximum": 100
                },
                "phases": {
                  "enum": [
                    1,
                    3
                  ]
                },
                "clause": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "special_loads": {
          "type": "object",
          "description": "Default kVA per special load, always overridable",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1
        },
        "design_table": {
          "type": "string",
          "description": "load_tables id used for classes and Herman-Beta"
        }
      }
    },
    "load_tables": {
      "type": "object",
      "description": "Herman-Beta load parameter tables by id",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "horizon_years",
          "phase_voltage_v",
          "classes"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "horizon_years": {
            "type": "integer",
            "minimum": 1
          },
          "phase_voltage_v": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "confidence_pct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100
          },
          "note": {
            "type": "string"
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "description",
                "alpha",
                "beta",
                "c_amps",
                "admd_kva"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "description": {
                  "type": "string"
                },
                "standard_class": {
                  "type": "string"
                },
                "lsm": {
                  "type": "string"
                },
                "income_min_zar": {
                  "type": "number",
                  "minimum": 0
                },
                "income_max_zar": {
                  "type": "number",
                  "minimum": 0
                },
                "alpha": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "beta": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "c_amps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "admd_kva": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "mean_a": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "sd_a": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "unverified"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "lv_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_voltage_v",
        "power_factor",
        "confidence_pct",
        "feeder_max_drop_pct",
        "service_max_drop_pct",
        "phase_rotation",
        "max_service_length_m",
        "service_conductor",
        "feeder_conductors"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "phase_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "power_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "confidence_pct": {
          "type": "number",
          "exclusiveMinimum": 50,
          "exclusiveMaximum": 100
        },
        "feeder_max_drop_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "service_max_drop_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "phase_rotation": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "R",
              "W",
              "B"
            ]
          }
        },
        "three_phase_counts_per_phase": {
          "type": "boolean"
        },
        "max_service_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "service_conductor": {
          "type": "string"
        },
        "feeder_conductors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overhead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "underground": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "service_conductors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "kiosk_spacing_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "overhead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_span_m",
        "min_ground_clearance_m",
        "min_road_clearance_m",
        "everyday",
        "max_load",
        "max_sag",
        "stay_angle_deg",
        "poles"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "max_span_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_ground_clearance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_road_clearance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attachment_below_top_m": {
          "type": "number",
          "minimum": 0
        },
        "everyday": {
          "type": "object",
          "required": [
            "temp_c",
            "wind_pa"
          ],
          "additionalProperties": false,
          "properties": {
            "temp_c": {
              "type": "number"
            },
            "wind_pa": {
              "type": "number",
              "minimum": 0
            },
            "max_pct_uts": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "max_load": {
          "type": "object",
          "required": [
            "temp_c",
            "wind_pa"
          ],
          "additionalProperties": false,
          "properties": {
            "temp_c": {
              "type": "number"
            },
            "wind_pa": {
              "type": "number",
              "minimum": 0
            },
            "max_pct_uts": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "max_sag": {
          "type": "object",
          "required": [
            "temp_c",
            "wind_pa"
          ],
          "additionalProperties": false,
          "properties": {
            "temp_c": {
              "type": "number"
            },
            "wind_pa": {
              "type": "number",
              "minimum": 0
            },
            "max_pct_uts": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "stay_angle_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stay_capacity_kn": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "poles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "length_m",
              "max_tip_load_kn"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "length_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "top_diameter_mm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_tip_load_kn": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "underground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "soil_resistivity_factor",
        "depth_factor",
        "ground_temp_factor",
        "grouping_factor"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "design": {
          "type": "object",
          "required": [
            "depth_m",
            "soil_resistivity_kmw",
            "ground_temp_c",
            "circuits_in_trench"
          ],
          "additionalProperties": false,
          "properties": {
            "depth_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "soil_resistivity_kmw": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ground_temp_c": {
              "type": "number"
            },
            "circuits_in_trench": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "soil_resistivity_factor": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1
        },
        "depth_factor": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1
        },
        "ground_temp_factor": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1
        },
        "grouping_factor": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mv_fault_mva",
        "voltage_factor_max",
        "voltage_factor_min",
        "min_fault_multiple_of_fuse",
        "transformers"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "mv_fault_mva": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voltage_factor_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voltage_factor_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contact_resistance_ohm": {
          "type": "number",
          "minimum": 0
        },
        "min_fault_multiple_of_fuse": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_lv_terminal_fault_ka": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transformers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kva",
              "z_pct"
            ],
            "additionalProperties": false,
            "properties": {
              "kva": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "z_pct": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x_r": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "fuse_ratings_a": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "voltage_factor_mv": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mv_fault_mva_min": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "mv_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominal_kv",
        "sending_voltage_pct",
        "max_drop_pct",
        "power_factor",
        "supply_voltage_band_pct",
        "max_lv_reach_m",
        "max_tee_m",
        "taps_pct",
        "pole_mount_max_kva",
        "pole_mount",
        "minisub",
        "mv_conductors"
      ],
      "properties": {
        "clause": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "nominal_kv": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sending_voltage_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_drop_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "power_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
